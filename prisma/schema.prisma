generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id          Int      @id @default(autoincrement())
  title_tr    String
  title_en    String
  desc_tr     String
  desc_en     String
  image       String?  // Cover image
  images      String?  // Additional gallery images (comma-separated URLs)
  category    String   @default("genel")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Faq {
  id          Int      @id @default(autoincrement())
  question_tr String
  question_en String
  answer_tr   String
  answer_en   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title_tr     String
  title_en     String
  desc_tr      String
  desc_en      String
  image        String?  // Custom uploaded image path
  features_tr  String   // Newline-separated list of features
  features_en  String   // Newline-separated list of features
  metaTitle_tr String?
  metaTitle_en String?
  metaDesc_tr  String?
  metaDesc_en  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  message   String?
  status    String   @default("new") // new, read, resolved
  createdAt DateTime @default(now())
}
